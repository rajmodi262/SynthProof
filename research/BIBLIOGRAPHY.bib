@misc{dibia2025privacylabel,
  author        = {Dibia, Onyinye and Lu, Mengyi and Bhattacharjee, Prianka and
                   Near, Joseph P. and Feng, Yuanyuan},
  title         = {{"We Need a Standard"}: Toward an Expert-Informed Privacy Label for
                   Differential Privacy},
  year          = {2025},
  eprint        = {2507.15997},
  archivePrefix = {arXiv},
  note          = {THE positioning citation. Nine-category expert-elicited label that overlaps
                   the Privacy Data Sheet almost field for field -- a kill on the concept and
                   simultaneously our strongest external validation. Proposes NO signing and NO
                   standard for reporting the limits of an empirical privacy metric, an omission
                   one of their own experts flagged as "privacy theater". Both gaps are what
                   `audit_ceiling` and the Ed25519 signature fill.}
}

