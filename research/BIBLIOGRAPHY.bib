@misc{preen2024sacro,
  author        = {Preen, Richard J. and Albashir, Maha and Davy, Simon and Smith, Jim},
  title         = {A Multi-Language Toolkit for the Semi-Automated Checking of Research Outputs},
  year          = {2024},
  eprint        = {2212.02935},
  archivePrefix = {arXiv},
  note          = {SACRO. Automated statistical disclosure control at the TRE exit point.
                   READS OUTPUT VALUES (cell frequencies, p\%-rule, NK-rule, regression dof) and
