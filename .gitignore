# Python
#
# The build-artifact directories below are ANCHORED with a leading slash so they match only
# at the repository root. Unanchored, `lib/` matches at any depth — which silently excluded
# `web/src/lib/api.ts` from a commit and broke CI with an unresolvable import. Any generic
# directory name in this file must stay anchored, or it will eventually eat real source.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
/venv/
/.venv/
/ENV/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Data & Results
data/raw/*
data/processed/*
!data/CHECKSUMS.txt
results/synthetic/*
*.pt
*.ckpt

# Environment & Keys
.env
.keys/

# Test & coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
data/*
!data/CHECKSUMS.txt

.venv311/

# Console: npm deps and build output (regenerate with `make console-build`)
web/node_modules/
synthproof/api/console/

# Thesis figures are generated; regenerate with `make figures`. The PDFs are kept for
# typesetting, the PNGs are not committed to avoid binary churn on every re-run.
docs/thesis/figures/*.png

# Per-cell grid checkpoints. Intermediate state; the aggregate is what gets committed.
results/h1_cells/
results/acs/h1_cells/
results/acs/h2_cells/
# folktables downloads ACS microdata here; ~200 MB, re-fetchable
data/acs/

# vitest output
web/coverage/

# Built pitch decks. `web/pitch*/vite.config.ts` sets outDir here, so these ~5 MB of
# assets are regenerable build output, not source. The sources live in web/pitch*/.
synthproof/api/pitch/
synthproof/api/pitch2/
synthproof/api/pitch3/
synthproof/api/pitch4/
synthproof/api/pitch5/

# Isolated env for the MLCommons Croissant reference validator. Built on demand by
# scripts/validate_croissant.py --setup; kept out of the project env because mlcroissant
# pins a numpy that breaks jax/mbi/private-PGM and therefore real AIM.
.venv-croissant/

# Playwright
web/test-results/
web/playwright-report/
web/blob-report/
web/.cache/

# demo fixtures and keys, rebuildable with `python -m scripts.setup_demo`
demo/
.demo_*.log
