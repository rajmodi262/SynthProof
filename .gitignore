# Python
#
# The build-artifact directories below are ANCHORED with a leading slash so they match only
# at the repository root. Unanchored, `lib/` matches at any depth — which silently excluded
# `web/src/lib/api.ts` from a commit and broke CI with an unresolvable import. Any generic
# directory name in this file must stay anchored, or it will eventually eat real source.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
/venv/
/.venv/
/ENV/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Data & Results
data/raw/*
data/processed/*
!data/CHECKSUMS.txt
results/synthetic/*
*.pt
*.ckpt

# Environment & Keys
.env
.keys/

# Test & coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
data/*
!data/CHECKSUMS.txt

.venv311/

# Console: npm deps and build output (regenerate with `make console-build`)
web/node_modules/
synthproof/api/console/

# Thesis figures are generated; regenerate with `make figures`. The PDFs are kept for
# typesetting, the PNGs are not committed to avoid binary churn on every re-run.
docs/thesis/figures/*.png

# Per-cell grid checkpoints. Intermediate state; the aggregate is what gets committed.
results/h1_cells/
